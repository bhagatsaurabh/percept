{
  "name": "canvas-percept",
  "version": "1.0.20",
  "description": "HTML5 Canvas rendering engine",
  "main": "dist/cjs/percept.js",
  "types": "dist/cjs/percept.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "shx rm -rf dist",
    "prebuild": "npm run clean",
    "build": "npm run build:umd && npm run build:cjs && npm run build:esm",
    "postbuild": "rollup --config rollup.config.mjs",
    "build:umd": "vite build",
    "build:cjs": "tsc",
    "build:esm": "tsc -m es6 --outDir dist/esm",
    "docs": "typedoc --plugin typedoc-plugin-extras --favicon static/favicon.ico && shx cp static/404.html docs/404.html",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhagatsaurabh/percept.git"
  },
  "keywords": [
    "canvas library",
    "html5 canvas engine",
    "2d library",
    "canvas engine",
    "html5 canvas library",
    "percept",
    "canvas percept",
    "canvas-percept",
    "canvas rendering library",
    "rendering library"
  ],
  "author": "Saurabh Bhagat",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/offscreencanvas": "^2019.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "shx": "^0.4.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-extras": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-canvas-mock": "^1.1.4"
  }
}
